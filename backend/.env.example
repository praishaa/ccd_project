# Copy this file to .env  (cp .env.example .env)

# PostgreSQL running in Docker (docker compose up -d):
DATABASE_URL=postgresql+psycopg2://blood:bloodpass@localhost:5432/blooddb

# No Docker? Comment the line above and use SQLite instead:
# DATABASE_URL=sqlite:///./blood.db

SECRET_KEY=change-this-to-a-long-random-string
ACCESS_TOKEN_EXPIRE_MINUTES=480
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
DONATION_INTERVAL_DAYS=90
